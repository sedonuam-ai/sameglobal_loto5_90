<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Génération par groupes Modulo 9"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choisissez un ou plusieurs groupes :"
        android:layout_marginBottom="8dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:layout_marginBottom="12dp">

        <CheckBox android:id="@+id/cbG1" android:text="G1" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/cbG2" android:text="G2" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/cbG3" android:text="G3" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/cbG4" android:text="G4" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/cbG5" android:text="G5" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/cbG6" android:text="G6" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/cbG7" android:text="G7" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/cbG8" android:text="G8" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/cbG9" android:text="G9" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />

    </GridLayout>

    <RadioGroup
        android:id="@+id/rgNombreGrillesModulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbModulo90"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbModulo180"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="180" />

        <RadioButton
            android:id="@+id/rbModulo360"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="360" />

    </RadioGroup>

    <Button
        android:id="@+id/btnGenererModulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GÉNÉRER AVEC CES GROUPES"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvResultatModulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="monospace" />

    </ScrollView>

</LinearLayout>
