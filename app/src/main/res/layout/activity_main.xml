<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/backgroundDark"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SAME GLOBAL SERVICES"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp"
        android:text="Loto5/90 Système Réducteur"
        android:textSize="16sp"
        android:textColor="@color/textSecondary"
        android:gravity="center" />

    <Button
        android:id="@+id/btnGenerer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/surfaceDark"
        android:textColor="@color/textPrimary"
        android:text="1. GÉNÉRER LE SYSTÈME" />

    <Button
        android:id="@+id/btnAfficherGrilles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/surfaceDark"
        android:textColor="@color/textPrimary"
        android:text="2. AFFICHER LES GRILLES" />

    <Button
        android:id="@+id/btnVerifier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/surfaceDark"
        android:textColor="@color/textPrimary"
        android:text="3. VÉRIFIER UN TIRAGE" />

    <Button
        android:id="@+id/btnStatistiques"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/surfaceDark"
        android:textColor="@color/textPrimary"
        android:text="4. STATISTIQUES" />

    <Button
        android:id="@+id/btnHistorique"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/surfaceDark"
        android:textColor="@color/textPrimary"
        android:text="5. HISTORIQUE" />

    <Button
        android:id="@+id/btnModulo9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="#FFFFFF"
        android:text="6. GÉNÉRATION PAR GROUPES MODULO 9" />

</LinearLayout>
