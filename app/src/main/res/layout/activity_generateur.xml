<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundDark"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Génération du système"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/rgNombreGrilles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rb90"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90"
            android:textColor="@color/textPrimary"
            android:buttonTint="@color/colorPrimary"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb180"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="180"
            android:textColor="@color/textPrimary"
            android:buttonTint="@color/colorPrimary" />

        <RadioButton
            android:id="@+id/rb360"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="360"
            android:textColor="@color/textPrimary"
            android:buttonTint="@color/colorPrimary" />

    </RadioGroup>

    <Button
        android:id="@+id/btnLancerGeneration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GÉNÉRER"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnVoirRepartition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VOIR RÉPARTITION"
        android:backgroundTint="@color/surfaceDark"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surfaceDarker"
            android:textColor="@color/textPrimary"
            android:padding="12dp"
            android:textSize="14sp"
            android:fontFamily="monospace" />

    </ScrollView>

</LinearLayout>
